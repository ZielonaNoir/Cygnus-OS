{
  "name": "@cygnus/cli",
  "version": "0.1.0",
  "description": "Cygnus-OS CLI tool for project sync and prompt management",
  "type": "module",
  "bin": {
    "cygnus": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
