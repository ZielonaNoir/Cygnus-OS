    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.0.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "prettier": "^3.7.4",
